# Keep hashed research artifacts byte-stable across Windows and Unix checkouts.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.stim text eol=lf
*.dem text eol=lf
*.png binary
*.pdf binary
*.docx binary
